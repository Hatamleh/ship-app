{
  "name": "shiptest",
  "version": "1.0.0",
  "description": "Shipping Management Application for Software Testing Education",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "setup": "prisma generate && prisma db push && prisma db seed",
    "seed": "prisma db seed",
    "ingest": "tsx scripts/ingest.ts",
    "reset": "rm -f prisma/dev.db prisma/dev.db-shm prisma/dev.db-wal && npm run setup"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.5",
    "@langchain/textsplitters": "^1.0.1",
    "@prisma/client": "^5.7.1",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "dompurify": "^3.4.13",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.5.4",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.10.6",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "prisma": "^5.7.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^8.2.0"
  },
  "type": "module"
}
