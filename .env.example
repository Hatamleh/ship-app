# Database
DATABASE_URL="file:./dev.db"

# Test Mode - Set to true to enable test-friendly features
NEXT_PUBLIC_TEST_MODE=true

# Security - IMPORTANT: Change these in production!
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-long-random-string

# AI Assistant & Agent
# Get your own key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Chat model used by the agent and the assistant.
# Any tool-capable model from https://openrouter.ai/models works.
# Verified good on this app's multi-step tool use:
#   openai/gpt-5.6-terra      (default)
#   google/gemini-3.5-flash
# Avoid google/gemini-3.5-flash-lite: it returns empty replies after tool calls.
OPENROUTER_MODEL=openai/gpt-5.6-terra

# Embedding model used to index the docs for RAG.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
